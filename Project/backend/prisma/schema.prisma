// ----------------------------------------------- ENUMS ----------------------------------------------- //

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProjectStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ----------------------------------------------- MODELS ----------------------------------------------- //

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  status    UserStatus @default(ACTIVE)
  password  String
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  // --- Virtual Relation Fields (Not stored in PostgreSQL) ---
  // Enables Prisma queries like: prisma.user.findUnique({ include: { projects: true } })
  projects     Project[] // One user can create multiple projects (1-to-Many)
  applications Application[] // One user can submit multiple applications (1-to-Many)
}

// -------------------------------------------------------------------------------------------------------------------------- //

model Project {
  id          String        @id @default(uuid())
  title       String
  description String
  githubUrl   String
  techStack   String[]
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Owner Relation (Cascade delete if user is removed)

  // --- Owner Relation ---

  ownerId String // Real DB column: Stores the creator's user UUID

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Links ownerId -> User.id. onDelete: Cascade = deleting a user deletes all their created projects

  applications Application[]
}

// -------------------------------------------------------------------------------------------------------------------------- //

model Application {
  id            String            @id @default(uuid())
  note          String
  githubProfile String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations (Cascade delete if project is deleted)

  // --- Applicant Relation ---
  userId String // Real DB column: Stores the applicant's UUID
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Links userId -> User.id. Deleting a user deletes their applications

  // --- Target Project Relation ---
  projectId String // Real DB column: Stores the project's UUID being applied to
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Links projectId -> Project.id. Deleting a project deletes all applications submitted to it

  // Enforce 1 application per user per project
  @@unique([userId, projectId])
}
