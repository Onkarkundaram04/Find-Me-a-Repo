// ============================================================
// START HERE — how the three models connect
// ============================================================
//
//   User    ── owns ──────> Project      (Project.ownerId         -> User.id)
//   User    ── applies ───> Application  (Application.userId     -> User.id)
//   Project ── receives ──> Application  (Application.projectId  -> Project.id)
//
// In plain words:
//   - a User creates many Projects
//   - a User sends many Applications
//   - an Application belongs to exactly ONE project AND ONE user
//
// Application is the bridge between the other two models. That is why it
// carries TWO foreign keys (userId and projectId) while Project carries one.
//
// One user, one project, one application:
//   @@unique([userId, projectId])
//   This is the line that makes "already applied" possible. The controller's
//   duplicate pre-check and the P2002 catch both depend on it.
//
// onDelete: Cascade (both relations):
//   - delete a User    -> their projects and their applications disappear
//   - delete a Project -> every application sent to it disappears
//   Nothing is left pointing at a row that no longer exists.
//
// Every id is String @default(uuid()), which is why controllers validate
// :id with UUID_REGEX before touching the database.
//
// techStack is String[] — a real Postgres array column, not JSON text.
// ============================================================


// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sample Database Testing

/**
 * model Test {
 * id        Int      @id @default(autoincrement())
 * message   String
 * createdAt DateTime @default(now())
